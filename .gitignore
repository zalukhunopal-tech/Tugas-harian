# Jangan pernah commit konfigurasi lokal yang berisi URL Web App, kunci, atau token.
.env
.env.*
*.local.*
konfigurasi-lokal*.json
rahasia*.txt
node_modules/
.DS_Store
*.log

# Hasil build (disajikan lewat GitHub Pages dari workflow, jangan di-commit)
dist/
dist-artefak/

# Arsip Android dibuat ulang dengan: python3 scripts/buat_zip_android.py (membawa salinan aplikasi, jadi jangan dilacak)
public/*.zip

# Berkas kerja Google AI Studio (tangkapan layar dan media sementara). Bisa berisi data pribadi, jadi jangan dilacak di repo publik.
.aistudio/
public/assets/aistudio/
