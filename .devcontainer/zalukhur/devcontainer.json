{
  "name": "ZalukhuR Downloader",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "22" } },
  "containerEnv": { "HOST": "0.0.0.0", "PORT": "8000" },
  "postCreateCommand": "bash zalukhur-downloader/run.sh setup",
  "postStartCommand": "nohup bash zalukhur-downloader/run.sh start > /tmp/zalukhur.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "ZalukhuR Downloader", "onAutoForward": "openBrowser", "visibility": "private" }
  }
}
